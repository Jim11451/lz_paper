/hepdata.182472.v1/t45","id":2016124,"location":null,"messages":false,"name":"O01v","processed_name":"O01v","resources":[]},{"data":{"csv":"https://www.hepdata.net/download/table/ins3199115/O04s/csv","json":"https://www.hepdata.net/download/table/ins3199115/O04s/json","root":"https://www.hepdata.net/download/table/ins3199115/O04s/root","yaml":"https://www.hepdata.net/download/table/ins3199115/O04s/yaml","yoda":"https://www.hepdata.net/download/table/ins3199115/O04s/yoda","yoda.h5":"https://www.hepdata.net/download/table/ins3199115/O04s/yoda.h5","yoda1":"https://www.hepdata.net/download/table/ins3199115/O04s/yoda1"},"description":"Limits and Significance for O04s couplings.","doi":"10.17182/hepdata.182472.v1/t46","id":2016125,"location":null,"messages":false,"name":"O04s","processed_name":"O04s","resources":[]}],"mode":"record","overall_status":"finished","participant_count":4,"recid":182472,"record":{"abstract":"We report on a search for dark matter particles interacting with xenon nuclei in an exposure of 2.84 tonne-years with the LUX-ZEPLIN (LZ) experiment. An extended nuclear recoil energy window up to approximately 270 keV enables searches for effective field theory and inelastic models of dark matter where high-energy recoils account for a larger fraction of the predicted recoil spectrum compared to the nominal spin independent interaction. We observe one event with characteristics consistent with a nuclear recoil of $248\\pm23\\,\\mathrm{(stat)}\\pm23\\,\\mathrm{(sys)}$ keV, in a region where the known background expectation is low. A profile likelihood ratio test finds tension with the background-only hypothesis at a global significance of 2.6$\u03c3$ when accounting for look-elsewhere effects, with a maximum local significance of 3.4$\u03c3$ across the models tested. We describe the analysis and event of interest, the background model used in the statistical inference, and detail several of the rare background topologies considered.","access_urls":{"links":{"csv":"https://www.hepdata.net/download/submission/ins3199115/1/csv","json":"https://www.hepdata.net/download/submission/ins3199115/1/json","root":"https://www.hepdata.net/download/submission/ins3199115/1/root","yaml":"https://www.hepdata.net/download/submission/ins3199115/1/yaml","yoda":"https://www.hepdata.net/download/submission/ins3199115/1/yoda","yoda-h5":"https://www.hepdata.net/download/submission/ins3199115/1/yoda.h5"}},"analyses":[],"arxiv_id":"arXiv:2609.02823","collaborations":["LZ"],"control_number":"182472","creation_date":"2026-09-02","data_abstract":null,"data_keywords":{"cmenergies":[],"observables":["S1","couplings","log_10(S2)"],"phrases":["data points","inelastic dark matter","WIMP","effective field theory"]},"doc_type":"publication","doi":"10.17182/hepdata.182472.v1","first_author":{"affiliation":"SLAC","full_name":"Akerib, D.S."},"hepdata_doi":"10.17182/hepdata.182472.v1","id":182472,"inspire_id":"3199115","journal_info":"No Journal Information","keywords":[],"last_updated":"Tue, 22 Sep 2026 07:49:39 GMT","parent_child_join":{"name":"parent_publication"},"publication_date":"2026-09-22T00:00:00","recid":182472,"resources":[],"subject_area":["hep-ex"],"summary_authors":[{"affiliation":"SLAC","full_name":"Akerib, D.S."},{"affiliation":"University Coll. London","full_name":"Al Musalhi, A.K."},{"affiliation":"Brown U. (main)","full_name":"Almquist, B.J."},{"affiliation":"UC, Santa Barbara","full_name":"Amarasinghe, C.S."},{"affiliation":"SLAC","full_name":"Ames, A."},{"affiliation":"LBNL, Berkeley","full_name":"Anderson, T."},{"affiliation":"Zurich U.","full_name":"Angelides, N."},{"affiliation":"Imperial Coll., London","full_name":"Araujo, H.M."},{"affiliation":"Maryland U.","full_name":"Armstrong, J.E."},{"affiliation":"SLAC","full_name":"Arthurs, M."}],"title":"Search for dark matter particle interactions in an extended nuclear recoil energy window with the LUX-ZEPLIN (LZ) experiment","type":["article"],"uuid":"147375a9-4c47-4a44-89e6-2c73536c101e","version":1,"year":"2026"},"record_type":"publication","related_recids":[],"related_to_this_recids":[],"resources_with_doi":[],"reviewers_notified":false,"site_url":"https://www.hepdata.net","status":"finished","table_id_to_show":2016080,"table_name_to_show":"Science Sample Data","version":1,"version_count":1,"watched":false}
